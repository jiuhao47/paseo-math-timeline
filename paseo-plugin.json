{
  "id": "math-timeline",
  "name": "Math timeline",
  "description": "在聊天中显示数学公式，支持桌面和 Android，并保留 Markdown / LaTeX 源码复制。",
  "requirements": {
    "paseo": ">=0.11.0 <1.0.0"
  },
  "build": [
    [
      "npm",
      "ci",
      "--ignore-scripts",
      "--include=dev"
    ],
    [
      "npm",
      "run",
      "browser:install"
    ],
    [
      "npm",
      "run",
      "build"
    ]
  ]
}
